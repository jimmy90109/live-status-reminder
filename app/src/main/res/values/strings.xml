    <string name="ypt_card_app_name">YPT</string>
    <string name="ypt_card_title">讀書時長</string>
    <string name="ypt_card_description">YPT 開始記錄讀書時間後，持續顯示目前累積時長；停止計時時自動移除。</string>
    <string name="ypt_simulate_start">模擬開始讀書</string>
    <string name="ypt_simulate_stop">模擬停止讀書</string>
