    <string name="monitoring_clock_running">讀取主要 timer 的 MetricStyle 或倒數 chronometer 結束時間。</string>
    <string name="monitoring_clock_paused">讀取 MetricStyle 提供的固定剩餘時間，不讓鏡像通知繼續倒數。</string>
    <string name="monitoring_clock_ended">主要來源通知移除、失效或倒數結束時清除。</string>
    <string name="clock_aod_update_warning_title">AOD 倒數更新限制</string>
    <string name="clock_aod_update_warning_description">AOD 或深度休眠期間無法保證每秒刷新；喚醒螢幕後會自動校正。</string>
    <string name="platform_special_status_warning_title">其他特殊情況不會顯示於即時通知</string>
    <string name="platform_special_status_warning_description">例如正在尋找其他外送員、餐點停止供應，或其他尚未支援的訂單／行程狀態。實際情況請以平台官方通知為主。</string>

    <string name="monitoring_ipass_entered">同一則通知同時包含「乘車碼交易」與「尚未出站」。</string>
    <string name="monitoring_ipass_exited">同一則通知同時包含「乘車碼交易」與「出站交易已完成」。</string>
    <string name="taiwan_pay_title">乘車碼狀態</string>
    <string name="taiwan_pay_description">偵測台灣行動支付的捷運上、下車通知；上車後顯示乘車碼捷徑，下車時自動移除。</string>
    <string name="taiwan_pay_simulate_boarding">模擬上車，顯示提醒  ↑</string>
    <string name="taiwan_pay_simulate_alighting">模擬下車，移除提醒  ✓</string>
    <string name="monitoring_taiwan_pay_boarding">通知標題或內文符合「[站名] 上車通知」。</string>
    <string name="monitoring_taiwan_pay_alighting">通知標題或內文符合「[站名] 下車通知」。</string>
    <string name="taiwan_pay_debug_open_payload">查看通知 payload</string>

    <string name="monitoring_foodpanda_on_the_way">包含「外送夥伴在路上」。</string>
    <string name="monitoring_foodpanda_arriving">包含「外送夥伴即將抵達」。</string>
    <string name="monitoring_foodpanda_ended">包含「已送達」、「訂單完成」、「已取消」或「訂單取消」。</string>

    <string name="monitoring_uber_pickup_en_route">標題為「[分鐘] 分鐘內上車」，且通知文字包含「在 [上車點] 碰面」。</string>
    <string name="monitoring_uber_pickup_nearby">標題為「[司機] 即將抵達」；或在 2 分鐘內上車且已取得車牌、車款或 PIN。</string>
    <string name="monitoring_uber_arrived">標題為「[司機] 已抵達」。</string>
    <string name="monitoring_uber_on_trip">標題為「下車地點：[時間]」，或通知文字包含「正在前往：[下車點]」。</string>
    <string name="monitoring_uber_ended">標題為「為您的行程評分」。</string>
    <string name="monitoring_uber_taxi_pickup_en_route">標題為「職業駕駛正在途中」，且內文包含「將在 [分鐘] 分鐘內抵達」。</string>
    <string name="monitoring_uber_taxi_pickup_approaching">標題為「職業駕駛在幾分鐘後就會抵達」，且內文包含「請準備好與職業駕駛碰面」。</string>
    <string name="monitoring_uber_taxi_pickup_nearby">標題為「職業駕駛即將抵達」；有提供時一併讀取車款與括號內車牌。</string>
    <string name="monitoring_uber_taxi_ended">標題為「為您的行程評分」。</string>

    <string name="monitoring_uber_eats_received">包含「訂單已收到」或「已收到您的訂單」。</string>
    <string name="monitoring_uber_eats_preparing">包含「正在準備訂單」或「準備訂單」。</string>
    <string name="monitoring_uber_eats_picking_up">包含「正在取餐」。</string>
    <string name="monitoring_uber_eats_on_the_way">包含「正前往您所在位置」、「正在前往您所在位置」或「即將抵達」。</string>
    <string name="monitoring_uber_eats_arriving">包含「快到了」。</string>
    <string name="monitoring_uber_eats_ended">包含「訂單已送達」、「已送達」、「訂單已取消」、「已取消」或「訂單取消」。</string>
    <string name="monitoring_pikmin_started">包含繁體「正在背景執行時種花」或簡體「正在背景执行时种花」。</string>
    <string name="monitoring_pikmin_stopped">來源種花通知被移除，或後續 Pikmin Bloom 通知不再符合種花文案。</string>
</resources>
