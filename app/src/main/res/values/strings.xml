    <string name="app_name">即時狀態提醒</string>
    <string name="notification_app_name">LiveStatus</string>
    <string name="notification_channel_name">即時狀態提醒</string>
    <string name="notification_channel_description">持續顯示倒數計時、讀書與健身時長、乘車、YouBike 騎乘費用、外送訂單與種花狀態</string>
    <string name="media_notification_channel_name">媒體播放即時通知</string>
    <string name="media_notification_channel_description">在來源媒體通知未成為 Live Update 時，靜音顯示目前播放內容。</string>
    <string name="home_intro_show">顯示首頁介紹</string>
    <string name="home_intro_hide">隱藏首頁介紹</string>
    <string name="home_intro_collapsed">首頁介紹已收合</string>
    <string name="home_intro_expanded">首頁介紹已展開</string>
    <string name="home_intro_description">媒體播放、倒數計時、YPT 讀書、Hevy 健身、乘車、YouBike 騎乘、外送與 Pikmin Bloom 種花期間，持續顯示重要狀態。</string>
    <string name="required_settings_description">完成設定後，App 就能把媒體播放、倒數計時、讀書與健身、乘車、外送與種花狀態變成即時通知。</string>
