    <string name="hevy_card_app_name">Hevy</string>
    <string name="hevy_card_title">健身進度</string>
    <string name="hevy_card_description">Hevy 訓練期間同步顯示目前動作、組數、重量、次數、休息倒數與來源操作；結束訓練時自動移除。</string>
    <string name="hevy_debug_open_payload">查看通知 payload</string>
    <string name="hevy_simulate_active_set">模擬進行訓練組</string>
    <string name="hevy_simulate_rest">模擬組間休息</string>
    <string name="hevy_simulate_finish">模擬結束訓練</string>
    <string name="monitoring_hevy_active_set">直接顯示來源的動作名稱與訓練組內文，不顯示訓練時間。</string>
    <string name="monitoring_hevy_rest">讀取下一個動作與組數，並同步顯示「休息 M:SS」。</string>
    <string name="monitoring_hevy_finished">Hevy 的訓練通知移除時清除即時通知。</string>
    <string name="hevy_live_open_action">開啟 Hevy</string>
    <string name="notification_debug_copy_payload">複製所有通知 payload</string>
    <string name="notification_debug_payload_copied">已複製通知 payload</string>

    <string name="you_bike_tracking_title">YouBike 騎乘費用追蹤</string>
    <string name="you_bike_tracking_description">YouBike 騎乘中顯示目前預估費用與下一次費用變更時間。目前支援全臺 YouBike 服務區域的一般會員費率；站點無法辨識時，可在還車後選擇寄送回報。</string>
    <string name="you_bike_debug_open_payload">查看通知 payload</string>
    <string name="you_bike_simulate_borrow">模擬借車，顯示費用追蹤</string>
    <string name="you_bike_simulate_electric_borrow">模擬 2.0E 借車，顯示費用追蹤</string>
    <string name="you_bike_simulate_unknown_borrow">模擬未知站點，選擇服務區域</string>
    <string name="you_bike_simulate_return">模擬還車，移除費用追蹤</string>
    <string name="monitoring_you_bike_borrowed">通知內文符合「借車成功」，並包含借車時間、站名、車柱與車號。</string>
    <string name="monitoring_you_bike_returned">通知內文符合「還車扣款成功」，且歸還車號與目前騎乘相同。</string>
    <string name="you_bike_choose_region_action">選擇服務區域</string>
    <string name="you_bike_tracking_controls_channel_name">YouBike 追蹤控制</string>
    <string name="you_bike_tracking_controls_channel_description">顯示短效且靜音的 YouBike 費用追蹤復原操作。</string>
    <string name="you_bike_tracking_hidden_title">已隱藏 YouBike 費用追蹤</string>
    <string name="you_bike_tracking_hidden_description">點擊通知即可恢復顯示</string>
    <string name="you_bike_region_picker_title">選擇服務區域</string>
    <string name="you_bike_region_picker_description">此選擇只套用於目前這趟騎乘。</string>
