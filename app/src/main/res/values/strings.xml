    <string name="media_playback_card_app_name">媒體播放</string>
    <string name="media_playback_card_title">正在播放 Live Update</string>
    <string name="media_playback_card_description">監聽系統首選的活躍媒體工作階段；來源通知尚未被提升時，顯示曲名、作者與可用的播放控制。</string>
    <string name="media_playback_language_independent">不依賴語言</string>
    <string name="media_playback_limitation_title">優先使用系統原生媒體介面</string>
    <string name="media_playback_limitation_description">Pixel 預設開啟；Samsung、小米及其他 OEM 通常已有媒體即時介面，因此預設關閉，但仍可手動開啟。手動設定後會保留您的選擇。</string>
